# ===== LLM / Embedding (OpenAI-compatible) =====
# DashScope example: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek example: https://api.deepseek.com/v1 (embedding not provided; use another provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# auto: use OpenAI-compatible API when key is set, otherwise local all-MiniLM-L6-v2 (384 dims)
# openai | local | auto
# Keep local if you only add an LLM key: switching to openai changes dimensions and
# requires wiping the data volume + re-seeding.
EMBEDDING_PROVIDER=auto
HF_ENDPOINT=https://hf-mirror.com

# ===== App =====
DATA_DIR=/data
SEEKDB_DATABASE=paperlens
COLLECTION_NAME=paper_chunks
CORS_ORIGINS=*

# ===== PowerContext =====
POWERCONTEXT_URL=http://powercontext:8000
POWERCONTEXT_TIMEOUT=30
# Set only when the PowerContext server enforces authentication.
POWERCONTEXT_TOKEN=

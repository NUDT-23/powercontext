# Copy to .env next to the compose files (or export in the shell) before use.
#
# Host port for the PowerContext API (container always listens on 8000).
POWERCONTEXT_HOST_PORT=8010

# --- PowerContext (filled by scripts/01_create_scope.py) -------------------
# URL as seen by helper scripts on the host:
PC_URL=http://127.0.0.1:8010
# URL as seen by the Dify api/worker containers (compose service DNS name):
PC_URL_IN_DOCKER=http://powercontext:8000
# Scope created by scripts/01_create_scope.py; the placeholder is replaced by
# scripts/02_render_dsl.py.
PC_SCOPE_ID=scp_replace_me
# Only used when POWERCONTEXT_SERVER_ACCESS_MODE=enforced. Leave empty in demo mode.
PC_TOKEN=

# --- Dify (filled by scripts/03_bootstrap_dify.py) -------------------------
DIFY_BASE_URL=http://127.0.0.1:8088
DIFY_CONSOLE_EMAIL=you@example.com
DIFY_CONSOLE_PASSWORD=change-me
# App API key (app-...) — never commit the real value.
DIFY_APP_API_KEY=

# --- Optional: local model proxy used during author testing ----------------
# The submitted DSL only contains the provider/model id; credentials are
# entered in Dify's model provider settings.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
